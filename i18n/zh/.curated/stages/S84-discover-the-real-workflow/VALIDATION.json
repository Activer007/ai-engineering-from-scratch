    {
      "id": "S84-source-03",
      "classification": "inherited assurance limitation inside typed inputs",
      "source_location": "code/main.py audit status rule",
      "segments": [
        "14-48:b0047"
      ],
      "finding": "grounded means no listed structural issues and at least one direct item. One direct item among 100 steps returns grounded with ratio 0.01. A zero-confidence direct item can also qualify; confidence is range checked, not used as weight or proof of truth. Empty strings for actor/action/source/observation are not semantically checked.",
      "tests": [
        "test_07_any_direct_can_ground_many_reported_steps",
        "test_08_confidence_not_a_truth_or_weight_gate",
        "test_13_empty_claims_are_not_semantically_validated"
      ],
      "translation_change_required": false,
      "source_modified": false
    },
    {
      "id": "S84-source-04",
      "classification": "educational exercise implementation boundary",
      "source_location": "docs/en.md:88; WorkflowStep fields",
      "segments": [
        "14-48:b0051"
      ],
      "finding": "Adding a missing-deployment exception path is assigned as an exercise. The provided model is a linear contiguous list with no explicit branch-start, trigger, authority, input or output fields; canonical example does not implement a branching workflow.",
      "evidence": "Full dataclass/code review; no new branch implementation claimed.",
      "translation_change_required": false,
      "source_modified": false
    },
    {
      "id": "S84-source-05",
      "classification": "out-of-annotation robustness limitation, not failure of stated typed contract",
      "source_location": "Evidence and WorkflowStep dataclasses / audit",
      "segments": [
        "14-48:b0047"
      ],
      "finding": "Python annotations are not runtime validators: direct=2 yields ratio 2.0 and grounded, order=True or 1.0 is accepted as order 1, and a string confidence raises TypeError. These are bounded synthetic misuse checks, not realistic data claims.",
      "tests": [
        "test_09_dataclass_annotations_do_not_enforce_boolean",
        "test_10_dataclass_order_not_integer_type_checked",
        "test_11_bad_confidence_type_raises"
      ],
      "translation_change_required": false,
      "source_modified": false
    },
