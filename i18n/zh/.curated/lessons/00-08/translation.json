      "target": "\n"
    },
    {
      "segment_id": "00-08:b0049",
      "kind": "paragraph",
      "heading_path": [
        "# Editor Setup",
        "## Build It",
        "### Step 2: Install Essential Extensions"
      ],
      "ordinal": 25,
      "source_sha256": "0333adeac056f4e3903a73e4a9465e68875c0f8be6dbc849cd88d22a4bfb8160",
      "target": "本课的 `code/.vscode/extensions.json` 文件包含完整的推荐扩展列表。打开项目目录时，VS Code 会提示你安装这些扩展。\n"
    },
    {
      "segment_id": "00-08:b0050",
      "kind": "separator",
      "heading_path": [
