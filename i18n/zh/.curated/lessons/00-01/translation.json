      ],
      "ordinal": 39,
      "source_sha256": "e53f087d8cf8b3ae0bf7c83eb1813e1662dec63cec6dbdbb40f4a2ae3ffff85e",
      "target": "```bash\nuv pip install torch torchvision torchaudio\n```\n"
    },
    {
