      "source_sha256": "a2b5d7f678b6f5d2e187bf95f931e3c21166e5eb59c5d6d59229db0b63efc49a",
      "target": "```bash\nnvidia-smi\n\n# Install PyTorch with CUDA\nuv pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu124\n```\n"
    },
    {
      "segment_id": "00-01:b0074",
      "kind": "separator",
      "heading_path": [
        "# Dev Environment",
        "## Build It",
