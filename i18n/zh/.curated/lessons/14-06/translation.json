    },
    {
      "segment_id": "14-06:b0069",
      "kind": "paragraph",
      "heading_path": [
        "# Tool Use and Function Calling",
        "## Build It"
      ],
      "ordinal": 35,
      "source_sha256": "05016cacb6e24c71bbb9c27b70063341836ce80ca9b0051722b156896107cb46",
      "target": "`code/main.py` 实现了一个具备生产系统形态的工具注册表：\n"
    },
    {
      "segment_id": "14-06:b0070",
      "kind": "separator",
