      "target": "## 要解决的问题\n"
    },
    {
      "segment_id": "00-03:b0012",
      "kind": "separator",
      "heading_path": [
        "# GPU Setup & Cloud",
        "## The Problem"
      ],
      "ordinal": 6,
      "source_sha256": "01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b",
