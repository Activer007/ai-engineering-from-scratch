      "heading_path": [
        "# GPT Model Assembly",
        "## The Concept",
        "### Generation: temperature, top-k, multinomial"
      ],
      "ordinal": 20,
      "source_sha256": "f9deebe29e6ba968ad7d8049b9c88324398663d53893cd8c949a83bd2c1fedd4",
      "target": "```figure\ncc-gpt-assembly\n```\n"
    },
    {
