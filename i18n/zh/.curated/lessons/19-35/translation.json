        "# GPT Model Assembly",
        "## Build It"
      ],
      "ordinal": 21,
      "source_sha256": "6c9f31a1dd61e788af4b32a1c50d7ec1011e03885d2b419a5c8e58944b51b882",
      "target": "## 动手实现\n"
    },
    {
      "segment_id": "19-35:b0042",
      "kind": "separator",
      "heading_path": [
        "# GPT Model Assembly",
        "## Build It"
      ],
      "ordinal": 21,
      "source_sha256": "01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b",
