      "target": "学习本课程，只需用到以下命令：\n"
    },
    {
      "segment_id": "00-02:b0048",
      "kind": "separator",
      "heading_path": [
        "# Git & Collaboration",
        "## Use It"
      ],
      "ordinal": 24,
      "source_sha256": "01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b",
