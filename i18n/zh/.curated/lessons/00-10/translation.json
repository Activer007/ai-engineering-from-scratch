    },
    {
      "segment_id": "00-10:b0112",
      "kind": "separator",
      "heading_path": [
        "# Terminal & Shell",
        "## Key Terms"
      ],
      "ordinal": 56,
      "source_sha256": "01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b",
