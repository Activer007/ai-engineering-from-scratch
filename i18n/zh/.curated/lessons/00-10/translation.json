      "source_sha256": "f0aa187708c2b2136fb0572bb75da259679b0a600d5d2f387862e485ebb5ddf1",
      "target": "本课程中，各工具的使用场景如下：\n"
    },
    {
      "segment_id": "00-10:b0104",
      "kind": "separator",
      "heading_path": [
        "# Terminal & Shell",
        "## Use It"
      ],
      "ordinal": 52,
