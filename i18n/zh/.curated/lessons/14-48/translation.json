      "source_sha256": "d81dda0e455e2385df6f704945a7eae6846db57466266ff3f74ca186dd93a603",
      "target": "```bash\npython3 code/main.py\npython3 -m unittest discover code/tests -v\n```\n"
    },
    {
      "segment_id": "14-48:b0050",
      "kind": "separator",
      "heading_path": [
        "# Discover the Workflow People Actually Perform",
        "## Build It"
      ],
      "ordinal": 25,
      "source_sha256": "01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b",
      "target": "\n"
    },
    {
      "segment_id": "14-48:b0051",
      "kind": "paragraph",
      "heading_path": [
        "# Discover the Workflow People Actually Perform",
