      ],
      "ordinal": 23,
      "source_sha256": "6c9f31a1dd61e788af4b32a1c50d7ec1011e03885d2b419a5c8e58944b51b882",
      "target": "## 动手实现\n"
    },
    {
      "segment_id": "14-48:b0046",
      "kind": "separator",
      "heading_path": [
        "# Discover the Workflow People Actually Perform",
        "## Build It"
      ],
      "ordinal": 23,
      "source_sha256": "01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b",
      "target": "\n"
    },
    {
      "segment_id": "14-48:b0047",
      "kind": "paragraph",
      "heading_path": [
        "# Discover the Workflow People Actually Perform",
        "## Build It"
      ],
      "ordinal": 24,
      "source_sha256": "a6343485db247084e0b39e00486b958d9e239b881db36ecc7510ff0ed118e822",
      "target": "本实验在每个工作流步骤上保存证据，校验顺序与置信度，计算直接证据占比（direct-evidence ratio），并写入 `outputs/workflow-evidence.json`。\n"
    },
    {
      "segment_id": "14-48:b0048",
      "kind": "separator",
      "heading_path": [
        "# Discover the Workflow People Actually Perform",
        "## Build It"
      ],
      "ordinal": 24,
      "source_sha256": "01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b",
      "target": "\n"
    },
    {
